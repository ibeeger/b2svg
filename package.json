{
  "name": "bitmap-to-vector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-only bitmap to SVG vectorizer built on VTracer (WebAssembly)",
  "scripts": {
    "prepare": "node scripts/build-vtracer-web.mjs",
    "predev": "node scripts/build-vtracer-web.mjs",
    "prebuild": "node scripts/build-vtracer-web.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@visioncortex/vtracer": "^1.0.0-alpha.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
